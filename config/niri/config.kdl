// Keep the first two workspaces for the browser and terminal; others are dynamic.
input {
    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
            options "ctrl:nocaps"
        }
    }
    touchpad {
        dwt
        tap
        natural-scroll
        accel-profile "flat"
        accel-speed 0.7
        scroll-factor 0.5
    }
    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }
}

output "HDMI-A-1" {
    mode "1920x1080@143.999"
    position x=0 y=0
}

workspace "1"
workspace "2"

prefer-no-csd

layout {
    gaps 5
    focus-ring {
        off
    }
    border {
        width 1
        active-color "#c8c093"
        inactive-color "#090618"
    }
}

animations {
    workspace-switch {
        duration-ms 150
        curve "ease-out-quad"
    }
}

window-rule {
    geometry-corner-radius 1
    clip-to-geometry true
}

window-rule {
    match at-startup=true app-id=r#"firefox$"#
    open-on-workspace "1"
}
window-rule {
    match at-startup=true app-id=r#"Alacritty"#
    open-on-workspace "2"
}

spawn-at-startup "swaybg" "-i" "/home/fjara/dotfiles/wallpapers/city_night.jpg" "-m" "fill"
spawn-at-startup "gammastep" "-m" "wayland" "-t" "6500:6500" "-g" "0.7" "-l" "0:0"
spawn-at-startup "waybar" "-c" "/home/fjara/.config/niri/waybar.jsonc"
spawn-at-startup "firefox" "-P" "default"
spawn-at-startup "alacritty"

binds {
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Tab { toggle-overview; }
    Mod+B { spawn "firefox" "-P" "default"; }
    Mod+W { spawn "firefox" "-P" "work"; }
    Mod+T { spawn "alacritty"; }
    Mod+Q { close-window; }
    Mod+Space { spawn-sh "nc -U $XDG_RUNTIME_DIR/walker/walker.sock"; }
    Mod+P { spawn "walker" "--provider" "clipboard"; }
    Mod+Alt+L { spawn "swaylock" "--indicator-idle-visible" "--image" "/home/fjara/Backgrounds/teatime.jpg"; }

    Mod+H { focus-column-left; }
    Mod+J { focus-column-up; }
    Mod+K { focus-column-down; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    Mod+D { focus-workspace-up; }
    Mod+F { focus-workspace-down; }
    Mod+Alt+D { move-window-to-workspace-up; }
    Mod+Alt+F { move-window-to-workspace-down; }

    Alt+Shift+F { fullscreen-window; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Alt+Space { switch-focus-between-floating-and-tiling; }
    Print { screenshot; }

    XF86AudioRaiseVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
}
